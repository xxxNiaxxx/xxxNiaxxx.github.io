{
  "manifest_version": 3,
  "name": "Βραχυχρόνια.ai – Δήλωση ΑΑΔΕ",
  "short_name": "Βραχυχρόνια.ai",
  "description": "Συμπληρώνει μόνη της τη δήλωση βραχυχρόνιας διαμονής στην ΑΑΔΕ με τα στοιχεία της κράτησης από το Βραχυχρόνια.ai.",
  "version": "2026.10.26.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www1.gsis.gr/taxisnet/short_term_letting/*",
    "https://aivrachychronia.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www1.gsis.gr/taxisnet/short_term_letting/*"
      ],
      "js": [
        "aade.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aivrachychronia.vercel.app/tax/autofill*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://www1.gsis.gr/*"
      ]
    }
  ]
}
