generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally;
  /// on Neon/Supabase use the pooled URL above and the direct URL here.
  directUrl = env("DIRECT_URL")
}

// ─── Identity & tenancy ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrganizationMember[]
  assignedTasks   Task[]               @relation("TaskAssignee")
  conversations   AIConversation[]
  proposedActions AIAction[]           @relation("AIActionCreatedBy")
  reviewedActions AIAction[]           @relation("AIActionReviewedBy")
  sentInvitations Invitation[]         @relation("InvitationSentBy")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Link that lets someone join an organization. Only a hash of the token is stored.
model Invitation {
  id               String    @id @default(cuid())
  organizationId   String
  email            String
  role             Role      @default(MEMBER)
  tokenHash        String    @unique
  invitedByUserId  String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

/// AUTO: individual up to 2 properties with an AMA, business from the 3rd (Greek rules).
enum TaxRegimeSetting {
  AUTO
  INDIVIDUAL
  BUSINESS
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  taxRegime TaxRegimeSetting @default(AUTO)
  /// Platform commission % by booking source, e.g. {"BOOKING_COM": 15, "AIRBNB": 15}. Null = defaults.
  commissionRates Json?
  /// Own income tax rate (%) for the business regime; null = estimate from the tax scale.
  businessTaxRate Decimal? @db.Decimal(5, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members         OrganizationMember[]
  properties      Property[]
  guests          Guest[]
  reservations    Reservation[]
  tasks           Task[]
  messages        Message[]
  transactions    Transaction[]
  aiConversations AIConversation[]
  aiActions       AIAction[]
  taxFilings      TaxFiling[]
  aiMemories      AIMemory[]
  invitations     Invitation[]
  calendarFeeds   CalendarFeed[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── Operations ──────────────────────────────────────────────────────

enum PropertyKind {
  APARTMENT
  DETACHED_HOUSE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  address        String?
  city           String
  country        String
  bedrooms       Int            @default(1)
  bathrooms      Int            @default(1)
  maxGuests      Int            @default(2)
  status         PropertyStatus @default(ACTIVE)
  basePrice      Decimal        @db.Decimal(12, 2)
  currency       String         @default("EUR") @db.Char(3)
  /// Αριθμός Μητρώου Ακινήτου (AADE short-term rental registry)
  ama            String?
  kind           PropertyKind   @default(APARTMENT)
  areaSqm        Int?
  /// Safety checklist and insurance: { fireExtinguisher: true, …, insuranceExpiresOn: "YYYY-MM-DD" }
  compliance     Json           @default("{}")
  /// Secret token of the property's public iCal export (for Airbnb/Booking to block dates).
  icalToken      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  tasks        Task[]
  transactions Transaction[]
  aiMemories   AIMemory[]
  calendarFeeds CalendarFeed[]

  @@index([organizationId, status])
}

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  country        String?
  /// Preferred language for messages (ISO 639-1). Null: derived from the country.
  language       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  messages     Message[]

  @@index([organizationId, lastName])
}

/// Channel a reservation came from. Phase 1 only creates MANUAL reservations;
/// the other values exist so channel integrations need no schema change.
enum ReservationSource {
  MANUAL
  AIRBNB
  BOOKING_COM
  DIRECT
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id                String                @id @default(cuid())
  organizationId    String
  propertyId        String
  guestId           String
  source            ReservationSource     @default(MANUAL)
  /// Id of the reservation in the source channel (set by future integrations).
  externalId        String?
  confirmationCode  String?
  checkIn           DateTime              @db.Date
  checkOut          DateTime              @db.Date
  guestsCount       Int                   @default(1)
  totalAmount       Decimal               @db.Decimal(12, 2)
  /// Free stay (relatives/friends, no rent): no income, no ΤΑΚΚ, no AADE stay declaration.
  complimentary     Boolean               @default(false)
  /// The iCal feed that created this reservation (amount and guest still to be filled in).
  calendarFeedId    String?
  /// UID of the iCal event, to recognise it on the next sync.
  icalUid           String?
  /// Every column of the platform's export row (Booking/Airbnb), shown as is on the reservation.
  platformDetails   Json?
  /// Platform commission charged on this stay (e.g. Booking.com 15%).
  commission        Decimal               @default(0) @db.Decimal(12, 2)
  currency          String                @default("EUR") @db.Char(3)
  status            ReservationStatus     @default(CONFIRMED)
  notes             String?
  cancelledAt       DateTime?
  declarationStatus StayDeclarationStatus @default(PENDING)
  declaredAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  calendarFeed CalendarFeed? @relation(fields: [calendarFeedId], references: [id], onDelete: SetNull)
  tasks        Task[]
  messages     Message[]
  transactions Transaction[]

  @@unique([organizationId, source, externalId])
  @@index([calendarFeedId, icalUid])
  @@index([organizationId, checkIn])
  @@index([propertyId, checkIn, checkOut])
}

/// Δήλωση Βραχυχρόνιας Διαμονής status for a stay.
enum StayDeclarationStatus {
  PENDING
  DECLARED
  NOT_REQUIRED
}

enum TaskType {
  CLEANING
  MAINTENANCE
  CHECK_IN
  CHECK_OUT
  INSPECTION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  propertyId       String
  reservationId    String?
  title            String
  description      String?
  type             TaskType     @default(OTHER)
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  /// Checklist items: [{ label: string, done: boolean }]
  checklist        Json         @default("[]")
  dueAt            DateTime?
  completedAt      DateTime?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([reservationId])
}

// ─── Communication ───────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  AIRBNB
  BOOKING_COM
  INTERNAL
}

enum MessageStatus {
  DRAFT
  PENDING
  SENT
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  reservationId  String?
  guestId        String?
  direction      MessageDirection @default(OUTBOUND)
  channel        MessageChannel   @default(INTERNAL)
  content        String
  status         MessageStatus    @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([organizationId, guestId])
  @@index([reservationId])
}

// ─── Financials ──────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  BOOKING
  CLEANING
  MAINTENANCE
  UTILITIES
  SUPPLIES
  PLATFORM_FEE
  OTHER
}

model Transaction {
  id              String              @id @default(cuid())
  organizationId  String
  propertyId      String
  reservationId   String?
  type            TransactionType
  category        TransactionCategory
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("EUR") @db.Char(3)
  description     String?
  transactionDate DateTime            @db.Date
  createdAt       DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([organizationId, transactionDate])
  @@index([propertyId, transactionDate])
}

// ─── AI ──────────────────────────────────────────────────────────────

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]
  actions      AIAction[]

  @@index([organizationId, userId, updatedAt])
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum AIActionStatus {
  PROPOSED
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

/// An operation the assistant proposed. Nothing is executed until a member
/// approves it; who proposed/reviewed it is kept for auditing.
model AIAction {
  id               String         @id @default(cuid())
  organizationId   String
  conversationId   String?
  type             String
  status           AIActionStatus @default(PROPOSED)
  payload          Json
  result           Json?
  createdByUserId  String?
  reviewedByUserId String?
  createdAt        DateTime       @default(now())
  reviewedAt       DateTime?
  executedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("AIActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy   User?           @relation("AIActionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ─── Tax filings ─────────────────────────────────────────────────────

enum TaxFilingKind {
  CLIMATE_FEE
  PRESENCE_FEE
  VAT
}

/// A periodic return the organization marked as filed (e.g. monthly climate-fee return).
model TaxFiling {
  id             String        @id @default(cuid())
  organizationId String
  kind           TaxFilingKind
  /// "YYYY-MM"
  period         String
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?
  filedAt        DateTime      @default(now())
  filedByUserId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, period])
}

// ─── AI memory ───────────────────────────────────────────────────────

enum AIMemoryKind {
  /// Practical information for guests (Wi-Fi, parking, door code procedure…), usually per property.
  GUEST_INFO
  /// How the team wants things done ("sign messages as…", "no cleaning before 11:00").
  PREFERENCE
  /// A guest-message template learned from a manager's edited and approved draft.
  MESSAGE_TEMPLATE
}

enum AIMemorySource {
  MANUAL
  CHAT
  EDIT
}

/// What the assistant has learned from the organization's managers.
model AIMemory {
  id              String         @id @default(cuid())
  organizationId  String
  propertyId      String?
  kind            AIMemoryKind
  content         String
  /// ISO 639-1 language of the content (templates and guest info).
  language        String?
  /// For MESSAGE_TEMPLATE: checkin | thanks | general
  messageKind     String?
  source          AIMemorySource @default(MANUAL)
  active          Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, active])
}

/// An iCal calendar of a property on Airbnb / Booking.com that is imported periodically.
model CalendarFeed {
  id             String            @id @default(cuid())
  organizationId String
  propertyId     String
  source         ReservationSource
  url            String
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([propertyId, url])
  @@index([organizationId])
}
