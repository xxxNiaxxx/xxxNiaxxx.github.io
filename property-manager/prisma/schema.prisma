generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally;
  /// on Neon/Supabase use the pooled URL above and the direct URL here.
  directUrl = env("DIRECT_URL")
}

// ─── Identity & tenancy ──────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  passwordHash    String
  /// Bumped to sign the user out everywhere: web sessions and mobile tokens carry the value they were issued with.
  sessionVersion  Int       @default(0)
  /// Version of the terms of service (lib/legal.ts) the user accepted, and when.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     OrganizationMember[]
  assignedTasks   Task[]               @relation("TaskAssignee")
  conversations   AIConversation[]
  proposedActions AIAction[]           @relation("AIActionCreatedBy")
  reviewedActions AIAction[]           @relation("AIActionReviewedBy")
  sentInvitations Invitation[]         @relation("InvitationSentBy")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Link that lets someone join an organization. Only a hash of the token is stored.
model Invitation {
  id               String    @id @default(cuid())
  organizationId   String
  email            String
  role             Role      @default(MEMBER)
  tokenHash        String    @unique
  invitedByUserId  String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

/// AUTO: individual up to 2 properties with an AMA, business from the 3rd (Greek rules).
enum TaxRegimeSetting {
  AUTO
  INDIVIDUAL
  BUSINESS
}

model Organization {
  id                   String           @id @default(cuid())
  name                 String
  taxRegime            TaxRegimeSetting @default(AUTO)
  /// Platform commission % by booking source, e.g. {"BOOKING_COM": 15, "AIRBNB": 15}. Null = defaults.
  commissionRates      Json?
  /// Own income tax rate (%) for the business regime; null = estimate from the tax scale.
  businessTaxRate      Decimal?         @db.Decimal(5, 2)
  /// Daily email of deadlines (declarations, ΤΑΚΚ, insurance) and the monthly report.
  emailReminders       Boolean          @default(true)
  /// Day (YYYY-MM-DD) the last reminder email went out, to send at most one a day.
  lastReminderOn       String?
  /// Month (YYYY-MM) of the last monthly report email.
  lastMonthlyReport    String?
  /// Guest replies drafted by the assistant (shown in "what the app saved you").
  aiRepliesDrafted     Int              @default(0)
  /// Stripe customer and subscription (lib/services/billing.ts).
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  /// Stripe subscription status: active, trialing, past_due, unpaid, canceled, incomplete…
  subscriptionStatus   String?
  /// Paid properties on the subscription.
  subscriptionQuantity Int?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  /// Free of charge (set by the app's administrators), e.g. partners and testers.
  billingExempt        Boolean          @default(false)
  /// The shared demo organization: reset every night, account actions locked.
  isDemo               Boolean          @default(false)
  /// Key of the last "the free period ends" email (e.g. 2026-12-01), sent once each.
  billingReminderSent  String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  members           OrganizationMember[]
  properties        Property[]
  guests            Guest[]
  reservations      Reservation[]
  tasks             Task[]
  messages          Message[]
  transactions      Transaction[]
  aiConversations   AIConversation[]
  aiActions         AIAction[]
  taxFilings        TaxFiling[]
  aiMemories        AIMemory[]
  invitations       Invitation[]
  calendarFeeds     CalendarFeed[]
  calendarConflicts CalendarConflict[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── Operations ──────────────────────────────────────────────────────

enum PropertyKind {
  APARTMENT
  DETACHED_HOUSE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  address          String?
  city             String
  country          String
  bedrooms         Int            @default(1)
  bathrooms        Int            @default(1)
  maxGuests        Int            @default(2)
  status           PropertyStatus @default(ACTIVE)
  basePrice        Decimal        @db.Decimal(12, 2)
  currency         String         @default("EUR") @db.Char(3)
  /// Αριθμός Μητρώου Ακινήτου (AADE short-term rental registry)
  ama              String?
  kind             PropertyKind   @default(APARTMENT)
  areaSqm          Int?
  /// Safety checklist and insurance: { fireExtinguisher: true, …, insuranceExpiresOn: "YYYY-MM-DD" }
  compliance       Json           @default("{}")
  /// Secret token of the property's public iCal export (for Airbnb/Booking to block dates).
  icalToken        String?        @unique
  /// Secret token of the property's guest guide (/guide/…).
  publicToken      String?        @unique
  /// Token of the direct booking page (/book/…) — separate, so the public booking link never opens the guide.
  bookingToken     String?        @unique
  /// "15:00"
  checkInTime      String?
  /// "11:00"
  checkOutTime     String?
  houseRules       String?
  /// The direct booking page (/book/…) takes booking requests.
  directBooking    Boolean        @default(false)
  /// Questions of the knowledge interview the manager chose to skip (topic keys).
  interviewSkipped String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  tasks         Task[]
  transactions  Transaction[]
  aiMemories    AIMemory[]
  calendarFeeds CalendarFeed[]

  @@index([organizationId, status])
}

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  country        String?
  /// Preferred language for messages (ISO 639-1). Null: derived from the country.
  language       String?
  /// Identity for the AADE stay declaration: ID_CARD, PASSPORT or TAX_ID (ΑΦΜ).
  idType         String?
  idNumber       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  messages     Message[]

  @@index([organizationId, lastName])
}

/// Channel a reservation came from. Phase 1 only creates MANUAL reservations;
/// the other values exist so channel integrations need no schema change.
enum ReservationSource {
  MANUAL
  AIRBNB
  BOOKING_COM
  DIRECT
  OTHER
  VRBO
  EXPEDIA
  AGODA
  TRIP_COM
  HOLIDU
  HOMETOGO
  TRAVEL_AGENCY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id                 String                @id @default(cuid())
  organizationId     String
  propertyId         String
  guestId            String
  source             ReservationSource     @default(MANUAL)
  /// Id of the reservation in the source channel (set by future integrations).
  externalId         String?
  confirmationCode   String?
  checkIn            DateTime              @db.Date
  checkOut           DateTime              @db.Date
  guestsCount        Int                   @default(1)
  totalAmount        Decimal               @db.Decimal(12, 2)
  /// Free stay (relatives/friends, no rent): no income, no ΤΑΚΚ, no AADE stay declaration.
  complimentary      Boolean               @default(false)
  /// The iCal feed that created this reservation (amount and guest still to be filled in).
  calendarFeedId     String?
  /// UID of the iCal event, to recognise it on the next sync.
  icalUid            String?
  /// Every column of the platform's export row (Booking/Airbnb), shown as is on the reservation.
  platformDetails    Json?
  /// Platform commission charged on this stay (e.g. Booking.com 15%).
  commission         Decimal               @default(0) @db.Decimal(12, 2)
  currency           String                @default("EUR") @db.Char(3)
  status             ReservationStatus     @default(CONFIRMED)
  notes              String?
  cancelledAt        DateTime?
  declarationStatus  StayDeclarationStatus @default(PENDING)
  /// For the AADE stay declaration (see lib/aade.ts); null = the platform default.
  paymentMethod      String?
  /// Secret token of the guest's online check-in page (/checkin/…).
  checkinToken       String?               @unique
  checkinCompletedAt DateTime?
  /// Expected arrival time given by the guest at online check-in ("17:30").
  arrivalTime        String?
  rulesAcceptedAt    DateTime?
  declaredAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest        Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  calendarFeed CalendarFeed? @relation(fields: [calendarFeedId], references: [id], onDelete: SetNull)
  tasks        Task[]
  messages     Message[]
  transactions Transaction[]

  @@unique([organizationId, source, externalId])
  @@index([calendarFeedId, icalUid])
  @@index([organizationId, checkIn])
  @@index([propertyId, checkIn, checkOut])
}

/// Δήλωση Βραχυχρόνιας Διαμονής status for a stay.
enum StayDeclarationStatus {
  PENDING
  DECLARED
  NOT_REQUIRED
}

enum TaskType {
  CLEANING
  MAINTENANCE
  CHECK_IN
  CHECK_OUT
  INSPECTION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String       @id @default(cuid())
  organizationId   String
  propertyId       String
  reservationId    String?
  title            String
  description      String?
  type             TaskType     @default(OTHER)
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  /// Checklist items: [{ label: string, done: boolean }]
  checklist        Json         @default("[]")
  dueAt            DateTime?
  completedAt      DateTime?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([reservationId])
}

// ─── Communication ───────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  AIRBNB
  BOOKING_COM
  INTERNAL
}

enum MessageStatus {
  DRAFT
  PENDING
  SENT
  FAILED
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  reservationId  String?
  guestId        String?
  direction      MessageDirection @default(OUTBOUND)
  channel        MessageChannel   @default(INTERNAL)
  content        String
  status         MessageStatus    @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([organizationId, guestId])
  @@index([reservationId])
}

// ─── Financials ──────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  BOOKING
  CLEANING
  MAINTENANCE
  UTILITIES
  SUPPLIES
  PLATFORM_FEE
  OTHER
}

model Transaction {
  id              String              @id @default(cuid())
  organizationId  String
  propertyId      String
  reservationId   String?
  type            TransactionType
  category        TransactionCategory
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("EUR") @db.Char(3)
  description     String?
  transactionDate DateTime            @db.Date
  createdAt       DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([organizationId, transactionDate])
  @@index([propertyId, transactionDate])
}

// ─── AI ──────────────────────────────────────────────────────────────

model AIConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]
  actions      AIAction[]

  @@index([organizationId, userId, updatedAt])
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum AIActionStatus {
  PROPOSED
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

/// An operation the assistant proposed. Nothing is executed until a member
/// approves it; who proposed/reviewed it is kept for auditing.
model AIAction {
  id               String         @id @default(cuid())
  organizationId   String
  conversationId   String?
  type             String
  status           AIActionStatus @default(PROPOSED)
  payload          Json
  result           Json?
  createdByUserId  String?
  reviewedByUserId String?
  createdAt        DateTime       @default(now())
  reviewedAt       DateTime?
  executedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("AIActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy   User?           @relation("AIActionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ─── Tax filings ─────────────────────────────────────────────────────

enum TaxFilingKind {
  CLIMATE_FEE
  PRESENCE_FEE
  VAT
}

/// A periodic return the organization marked as filed (e.g. monthly climate-fee return).
model TaxFiling {
  id             String        @id @default(cuid())
  organizationId String
  kind           TaxFilingKind
  /// "YYYY-MM"
  period         String
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?
  filedAt        DateTime      @default(now())
  filedByUserId  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, period])
}

// ─── AI memory ───────────────────────────────────────────────────────

enum AIMemoryKind {
  /// Practical information for guests (Wi-Fi, parking, door code procedure…), usually per property.
  GUEST_INFO
  /// How the team wants things done ("sign messages as…", "no cleaning before 11:00").
  PREFERENCE
  /// A guest-message template learned from a manager's edited and approved draft.
  MESSAGE_TEMPLATE
}

enum AIMemorySource {
  MANUAL
  CHAT
  EDIT
  /// Answered in the knowledge interview
  INTERVIEW
  /// Read from the listing on Booking.com / Airbnb
  IMPORT
}

/// What the assistant has learned from the organization's managers.
model AIMemory {
  id              String         @id @default(cuid())
  organizationId  String
  propertyId      String?
  kind            AIMemoryKind
  content         String
  /// ISO 639-1 language of the content (templates and guest info).
  language        String?
  /// For MESSAGE_TEMPLATE: checkin | thanks | general
  messageKind     String?
  source          AIMemorySource @default(MANUAL)
  /// Knowledge-interview topic this note answers (wifi, parking, …).
  topic           String?
  active          Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, active])
}

/// An iCal calendar of a property on Airbnb / Booking.com that is imported periodically.
model CalendarFeed {
  id             String            @id @default(cuid())
  organizationId String
  propertyId     String
  source         ReservationSource
  url            String
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  conflicts    CalendarConflict[]

  @@unique([propertyId, url])
  @@index([organizationId])
}

/// A stay in a platform calendar that falls on dates already taken by another
/// reservation: a possible double booking, shown until it is resolved.
model CalendarConflict {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  feedId         String
  icalUid        String
  start          DateTime  @db.Date
  end            DateTime  @db.Date
  /// Platform booking code of the stay, when the calendar gives one.
  code           String?
  /// The reservations it overlaps.
  reservationIds String[]
  detectedAt     DateTime  @default(now())
  notifiedAt     DateTime?
  /// The stay left the calendar or no longer overlaps.
  resolvedAt     DateTime?
  /// Marked by the team as not a double booking.
  dismissedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feed         CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, icalUid, start, end])
  @@index([organizationId, resolvedAt, dismissedAt])
}

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
  REGISTERED
}

/// Someone who asked to try the app. Approval gives them a personal sign-up link.
model WaitlistEntry {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  phone             String?
  city              String?
  propertiesCount   Int?
  /// BOOKING_COM, AIRBNB, DIRECT, OTHER
  platforms         String[]
  /// INDIVIDUAL or BUSINESS
  regime            String?
  /// ANDROID, IPHONE or NONE (computer only)
  device            String?
  /// Google account to add as a tester on Google Play (Android).
  playEmail         String?
  message           String?
  consentAt         DateTime
  status            WaitlistStatus @default(PENDING)
  tokenHash         String?        @unique
  tokenExpiresAt    DateTime?
  approvedAt        DateTime?
  /// When the approval email went out (null: not sent, share the link by hand).
  approvalEmailedAt DateTime?
  registeredAt      DateTime?
  userId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
}

/// Settings of the whole installation (not of an organization).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum FeedbackKind {
  BUG
  IDEA
  OTHER
}

/// A comment from a user ("Στείλτε σχόλιο"), read by the app's administrators.
model Feedback {
  id             String       @id @default(cuid())
  userId         String?
  email          String
  organizationId String?
  kind           FeedbackKind @default(OTHER)
  message        String
  /// Page the user was on.
  page           String?
  /// Web or the mobile app.
  client         String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([resolvedAt, createdAt])
}

/// Attempts per key and time window (login, public forms), shared by all server instances.
model RateLimit {
  key       String
  window    BigInt
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@id([key, window])
  @@index([createdAt])
}

/// An unexpected server error, grouped by signature; the app's administrators are emailed once per group.
model ErrorEvent {
  id          String    @id @default(cuid())
  signature   String    @unique
  /// api, page or cron
  source      String
  message     String
  stack       String?
  path        String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  notifiedAt  DateTime?
  resolvedAt  DateTime?

  @@index([resolvedAt, lastSeenAt])
}
