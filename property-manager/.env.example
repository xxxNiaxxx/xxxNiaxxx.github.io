# PostgreSQL (docker compose up -d db uses these credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_manager?schema=public"
# Direct (non-pooled) URL for migrations — same as DATABASE_URL locally
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/property_manager?schema=public"
# Separate database used by `npm test` (it is wiped by the test suite)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_manager_test?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# OpenAI-compatible chat completions API. Leave AI_API_KEY empty to use the
# built-in offline assistant (rule-based, still answers from real data).
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Product name shown in the UI
NEXT_PUBLIC_APP_NAME="Βραχυχρόνια.ai"
# Time zone used for "today", check-in times and task due dates
NEXT_PUBLIC_APP_TIMEZONE=Europe/Athens
# Public contact shown in the privacy policy and account-deletion pages
NEXT_PUBLIC_SUPPORT_EMAIL=

# Secret for the nightly iCal sync (Vercel Cron sends it as "Authorization: Bearer …").
# Any long random text; without it the nightly sync is off (the app still syncs when opened).
CRON_SECRET=

# Waitlist: emails (comma separated) of the people who approve testers at /admin/waitlist.
ADMIN_EMAILS=
# Sending emails (any SMTP). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your Gmail, SMTP_PASSWORD=an app password (Google account → Security →
# App passwords). Without these, approval links are copied and sent by hand.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "Βραχυχρόνια.ai <you@gmail.com>" (defaults to SMTP_USER)
EMAIL_FROM=
# Google Play testing link (Play Console → Testing → "Join on the web" link); sent to Android testers.
PLAY_TESTING_URL=
