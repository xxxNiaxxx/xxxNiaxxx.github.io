{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": [],
    "types": ["node"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["**/*.ts"]
}
