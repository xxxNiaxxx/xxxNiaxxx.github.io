# Politis — environment variables
# Copy to `.env.local` and fill in. Never commit real values.
#
# Only variables prefixed with EXPO_PUBLIC_ are bundled into the client.
# They must contain PUBLIC values only (the Supabase anon key is designed to be public;
# Row Level Security protects user data).

# Supabase project (leave empty to run in local demo mode with mock data)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Assistant mode: "mock" (default, deterministic answers, no API key needed)
# or "remote" (calls the Supabase Edge Function `assistant`, which holds the LLM key server-side).
EXPO_PUBLIC_ASSISTANT_MODE=mock

# Set to "false" to disable the (privacy-preserving) analytics abstraction entirely.
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets, NOT here:
#   supabase secrets set ANTHROPIC_API_KEY=...
#   supabase secrets set ASSISTANT_MODEL=claude-opus-5-5   # optional
# NEVER put the Supabase service role key or any LLM API key in an EXPO_PUBLIC_ variable.
# ---------------------------------------------------------------------------
