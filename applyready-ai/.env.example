# ApplyReady AI — environment variables. Placeholders only: never commit real values.
# Local: copy to .env.local (git-ignored). Vercel: Project → Settings → Environment Variables.
# Only the two NEXT_PUBLIC_ values at the bottom reach the browser; everything else stays on the server.

# ---------------------------------------------------------------------------
# AI provider (any OpenAI-compatible Chat Completions API)
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT with Ollama (works only where Ollama runs — never on Vercel):
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.1:8b

# PRODUCTION (set these in Vercel instead; use a paid provider whose terms and data
# processing agreement cover your users' regions — see DEPLOYMENT.md):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://YOUR_PROVIDER_API_BASE/v1
# AI_API_KEY=your_secret_key
# AI_MODEL=your_model_name

# Screenshot import (reading a CV / job ad from an image). Off unless set.
# Needs a vision-capable model on the same provider, e.g. llama3.2-vision in Ollama.
# AI_VISION_MODEL=llama3.2-vision

# Optional tuning
# AI_TIMEOUT_MS=55000         # 5000–58000; the route itself stops at 60 s
# AI_MAX_OUTPUT_TOKENS=4000   # 500–16000; caps the cost of each request
# AI_JSON_MODE=true           # set to false if the provider rejects response_format

# ---------------------------------------------------------------------------
# Abuse limits (a shared, durable store is REQUIRED on Vercel)
# ---------------------------------------------------------------------------
# Upstash Redis REST credentials. The Vercel marketplace integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
# Without them the app uses process memory (fine locally) and refuses to
# generate on Vercel with "limiter_not_configured".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generations + revisions per visitor per UTC day
MAX_GENERATIONS_PER_IP_PER_DAY=10
# Whole site per UTC day: caps your AI bill
MAX_GENERATIONS_GLOBAL_PER_DAY=300
# Also used for CV file imports (PDF/DOCX/TXT)
MAX_EXPORTS_PER_IP_PER_DAY=100
# Screenshot reads per visitor per day (they also count against the global budget)
MAX_IMAGE_READS_PER_IP_PER_DAY=20
# Random string, so hashed IPs in rate-limit keys cannot be reversed by guessing
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Premium themes via Stripe — OFF until every item below is set.
# Use TEST keys (sk_test_…). Live keys are refused unless STRIPE_LIVE_MODE_APPROVED=true.
# ---------------------------------------------------------------------------
PREMIUM_THEMES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_CREATIVE=
# 32+ random characters; signs the purchase tokens kept in the buyer's browser.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENTITLEMENT_SECRET=
STRIPE_LIVE_MODE_APPROVED=false

# ---------------------------------------------------------------------------
# Public values (visible in the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown in the privacy notice, e.g. an email address for questions and requests
NEXT_PUBLIC_SUPPORT_CONTACT=
